{
  "name": "porras-run",
  "version": "0.0.0",
  "private": true,
  "description": "PorraRun: mensajes de ánimo para corredores (web, Android e iOS)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start -w @porras/mobile",
    "web": "npm run web -w @porras/mobile",
    "android": "npm run android -w @porras/mobile",
    "export:web": "npm run export:web -w @porras/mobile",
    "package:web": "tar -czf porras-web.tar.gz -C apps/mobile/dist .",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
