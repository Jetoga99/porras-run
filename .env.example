# Copia este archivo como .env (no se sube a Git) y cambia los valores.
# En PowerShell puedes generar un secreto con:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))

# Contraseña del usuario "porras" de PostgreSQL.
POSTGRES_PASSWORD=porras_local

# Firma de las sesiones (JWT). Larga y aleatoria.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Sal para el hash de las IP de quienes mandan porras.
IP_HASH_SALT=cambia-esto-tambien

# Puerto de PostgreSQL en esta PC (dentro de Docker sigue siendo 5432).
PORRAS_DB_PORT=5433

# Puertos de Nginx (cámbialos si el 80 o el 443 están ocupados).
PORRAS_HTTP_PORT=80
PORRAS_HTTPS_PORT=443
